// cobs.nv — Consistent Overhead Byte Stuffing, the framing a serial
// link uses when one byte value means the end of a frame.
//
// A stream of frames needs a delimiter, and a delimiter only works if
// it cannot occur inside a frame.  COBS removes every `0x00` from a
// payload so that `0x00` can be the delimiter.  It replaces each zero
// with the distance to the next one.  The encoded stream is a run of
// blocks, each led by a length byte saying how many bytes it covers,
// and the zero a block stood for is put back by the decoder rather
// than carried on the wire.
//
// The overhead is at most one byte per 254 bytes of payload plus one,
// whatever the data.  There is no input that doubles a frame, which is
// what makes COBS usable on a link whose buffers are sized in advance.
//
// There are two pairs of calls.  `encode` and `decode` allocate their
// answer.  `encode_into` and `decode_into` write into a cursor the
// caller owns and allocate nothing.  `max_encoded_len` is the size a
// caller reserves, and a malformed frame is reported as a value.  Each
// call carries a worked example below.
//
// The in-place pair takes a cursor rather than a buffer and an offset.
// A `Bytes` passed as a parameter is borrowed, so a write through it
// lands in a copy the caller never sees.  A cursor owns its buffer, so
// a write through one lands where the caller can read it.  The
// standard library's own writers follow the same rule.
//
// Encoding is one pass over the input, one output byte per input byte
// plus the block headers, and one back-patch per block.  A block's
// length is only known once the block ends, so the encoder reserves
// the header byte, keeps writing, and seeks back to fill it in.  The
// seek costs nothing.  The buffer is the cursor's own, so the patch is
// a write in place.
//
// This module writes and reads bytes and nothing else.  No delimiter
// is added and none is expected.  Appending the `0x00` that separates
// frames belongs to the caller, who is usually placing it inside a
// larger buffer anyway.

use std.bytes

// The most bytes one block can cover, itself included.  A header of
// `0xff` means a full block that stands for no zero, so 254 is the
// most payload one block can carry.
fn full_block() -> Int
    0xff

// The most bytes `encode` can produce from `len` bytes of payload.
// The count is one header per full block, plus the header every frame
// opens with.
//
// A buffer of this size is never too small, and never wasteful by more
// than a byte.  A payload with no zeros in it reaches the bound
// exactly, except when `len` is a positive multiple of 254.  There the
// last block is a full one at the very end of the input.  It stands
// for no zero, so it opens no successor, while this formula has
// already counted one.  `max_encoded_len(254)` is 256 and `encode`
// writes 255, and the same holds at 508, at 762 and at every step of
// 254 after.  Treat the number as an upper bound, which is what a
// caller sizing a buffer wants from it.
//
// The count does not include the `0x00` delimiter, which this module
// neither writes nor reads.
//
// ```novo
// // One byte of overhead for a short frame, whatever is in it.
// println("${cobs.max_encoded_len(0)} ${cobs.max_encoded_len(4)}")   // 1 5
//
// // A second header appears only once a block is full.
// println("${cobs.max_encoded_len(253)} ${cobs.max_encoded_len(254)}")   // 254 256
// ```
pub fn max_encoded_len(len: Int) -> Int
    len + len / 254 + 1

// What went wrong while decoding, and where.
//
// Both variants are input faults, so both are values.  A frame
// arriving off a wire is data, and refusing to answer it is a result
// while crashing is not.  Each variant carries the offset in the
// encoded frame, so a receiver logging a bad frame can say where it
// stopped making sense.  `decode` carries the worked example.
pub enum CobsError
    // A `0x00` inside the encoded stream, which the encoding never
    // produces.  The delimiter arrived early, or the frame is corrupt.
    ZeroInFrame(at: Int)
    // A block header covering more bytes than the frame has left.
    Truncated(at: Int)

// The standard `Error` implementation, so a bad frame can be reported
// by anything that reports errors.
impl Error for CobsError
    // The one-line report, naming what was wrong with the frame and
    // the offset in it.  The offset is in the text rather than left
    // for the caller to add, because a receiver logging one frame in a
    // thousand is the caller least likely to still have it.
    fn message(self) -> Str
        match self
            ZeroInFrame(at) => "cobs: a zero byte at offset ${at}, which an encoded frame never contains"
            Truncated(at)   => "cobs: the block header at offset ${at} covers more bytes than the frame has"

// Encode `src` at the cursor, and answer the number of bytes written.
// The frame goes into the caller's buffer and nothing is allocated.
//
// The cursor must have `max_encoded_len(bytes.len(src))` bytes of
// room.  Too little is a panic, exactly as it is for `c.put_u8` and
// for `xs[i]`.  A buffer the caller sized wrong is a mistake in the
// program, not a value the program should carry around.  No delimiter
// is written, so the cursor is left on the byte after the frame and
// the caller can put the `0x00` there.
//
// ```novo
// use std.bytes
//
// // A payload with a zero in it, framed into a buffer the caller owns.
// let payload = bytes.from_hex("1100ff") ?? bytes.zeros(0)
// var out = bytes.cursor_le(bytes.zeros(cobs.max_encoded_len(3)))
// let n = cobs.encode_into(out, payload)
// println("${n}")                                          // 4
// println(bytes.to_hex(bytes.slice(out.finish(), 0, n)))   // 021102ff
// ```
pub fn encode_into(mut dst: Cursor, src: Bytes) -> Int
    let len = bytes.len(src)
    let start = dst.pos()
    // The offset of the header byte reserved for the block being
    // written, and the count that will go into it.  A header counts
    // itself, so a block that has covered nothing yet is 1.
    var header_at = dst.pos()
    dst.skip(1)
    var covered = 1
    for i in 0..len
        let b = bytes.byte_at(src, i) ?? 0
        if b == 0
            // A zero ends the block.  The header is what stands for
            // it, and the zero itself never goes on the wire.
            patch(dst, header_at, covered)
            header_at = dst.pos()
            dst.skip(1)
            covered = 1
        else
            dst.put_u8(b)
            covered = covered + 1
            // A block cannot cover more than 0xff bytes.  The next
            // header is only opened when there is something for it to
            // cover.  A full block at the very end of the input stands
            // for no zero and needs no successor.
            if covered == full_block() and i + 1 < len
                patch(dst, header_at, covered)
                header_at = dst.pos()
                dst.skip(1)
                covered = 1
    patch(dst, header_at, covered)
    dst.pos() - start

// Write `covered` into the header byte reserved at `header_at` and put
// the cursor back where it was.  This is the back-patch every
// length-prefixed format needs.
fn patch(mut dst: Cursor, header_at: Int, covered: Int)
    let here = dst.pos()
    dst.seek(header_at)
    dst.put_u8(covered)
    dst.seek(here)

// Encode `src` into a fresh buffer of exactly the length it needed.
//
// One allocation, for the caller assembling a message rather than
// filling a frame.  The answer contains no `0x00`, so the caller may
// append the delimiter to it directly.
//
// ```novo
// use std.bytes
//
// // Every zero is gone from the encoding, and comes back on the way out.
// let payload = bytes.from_hex("110000ff") ?? bytes.zeros(0)
// println(bytes.to_hex(cobs.encode(payload)))   // 02110102ff
//
// match cobs.decode(cobs.encode(payload))
//     Ok(back) => println(bytes.to_hex(back))   // 110000ff
//     Err(e)   => println(e.message())
// ```
pub fn encode(src: Bytes) -> Bytes
    var c = bytes.cursor_le(bytes.zeros(max_encoded_len(bytes.len(src))))
    let n = encode_into(c, src)
    bytes.slice(c.finish(), 0, n)

// Decode `wire` at the cursor, and answer the number of bytes written.
// The payload goes into the caller's buffer and nothing is allocated.
//
// `bytes.len(wire)` bytes of room is always enough, because decoding
// never grows a frame.  `wire` must be one frame with the delimiter
// already stripped.  A `0x00` anywhere in it is `ZeroInFrame`, since
// that is the byte the encoding exists to remove.
//
// ```novo
// use std.bytes
//
// let wire = bytes.from_hex("021102ff") ?? bytes.zeros(0)
// var out = bytes.cursor_le(bytes.zeros(4))
// match cobs.decode_into(out, wire)
//     Ok(n)  => println("${n} ${bytes.to_hex(bytes.slice(out.finish(), 0, n))}")
//     Err(e) => println(e.message())
// // 3 1100ff
// ```
pub fn decode_into(mut dst: Cursor, wire: Bytes) -> Result<Int, CobsError>
    let len = bytes.len(wire)
    let start = dst.pos()
    var at = 0
    var failure: ?CobsError = None
    var more = len > 0
    while more
        let header = bytes.byte_at(wire, at) ?? 0
        if header == 0
            failure = Some(ZeroInFrame(at: at))
            more = false
        else if at + header > len
            failure = Some(Truncated(at: at))
            more = false
        else
            // A header counts itself, so `header - 1` bytes follow it.
            let bad = copy_block(dst, wire, at + 1, at + header)
            if bad >= 0
                failure = Some(ZeroInFrame(at: bad))
                more = false
            else
                at = at + header
                more = at < len
                // A full block is a run that continues and stands for
                // no zero.  Every shorter one ended at a zero the
                // encoder removed, and the decoder puts it back.
                if more and header != full_block()
                    dst.put_u8(0)
    match failure
        None    => Ok(dst.pos() - start)
        Some(e) => Err(e)

// `wire[from, to)` onto the cursor, stopping at the first `0x00` and
// answering its offset, or -1 when the block was clean.  A zero inside
// a block is the one byte an encoded frame cannot contain, so finding
// one is the frame being wrong rather than a position to keep decoding
// from.
fn copy_block(mut dst: Cursor, wire: Bytes, from: Int, to: Int) -> Int
    var bad = 0 - 1
    for i in from..to
        if bad < 0
            let b = bytes.byte_at(wire, i) ?? 0
            if b == 0
                bad = i
            else
                dst.put_u8(b)
    bad

// Decode `wire` into a fresh buffer of exactly the length it needed.
//
// The round trip is exact.  `decode(encode(p))` is `p` for every
// payload, zeros included.  A frame that no encoder produced is an
// `Err` naming the offset, never a panic, because a receiver holding a
// corrupt frame wants to log it and read the next one.
//
// ```novo
// use std.bytes
//
// match cobs.decode(bytes.from_hex("021102ff") ?? bytes.zeros(0))
//     Ok(p)  => println(bytes.to_hex(p))    // 1100ff
//     Err(e) => println(e.message())
//
// // A zero cannot occur in an encoded frame, so one is the frame being
// // wrong rather than a place to carry on from.
// match cobs.decode(bytes.from_hex("020011") ?? bytes.zeros(0))
//     Ok(p)  => println(bytes.to_hex(p))
//     Err(e) => println(e.message())        // cobs: a zero byte at offset 1 …
//
// // A header that claims more than the frame has left.
// match cobs.decode(bytes.from_hex("0511") ?? bytes.zeros(0))
//     Ok(p)  => println(bytes.to_hex(p))
//     Err(e) => println(e.message())        // cobs: the block header at offset 0 …
// ```
pub fn decode(wire: Bytes) -> Result<Bytes, CobsError>
    var c = bytes.cursor_le(bytes.zeros(bytes.len(wire) + 1))
    let n = decode_into(c, wire)!
    Ok(bytes.slice(c.finish(), 0, n))
