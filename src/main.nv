// main.nv — the entry point of a library package, so there is no
// program here.
//
// A manifest names an entry point whether or not anything runs it.  A
// dependency's entry point is never built.  This file is that name,
// and it says what to do instead.

fn main() [io]
    println("cobs-nv: a library.  Depend on it and `use cobs`")
